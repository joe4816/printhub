{
  "manifest_version": 3,
  "name": "PrintHub ChromeOS Bridge (Optional)",
  "version": "0.1.0",
  "description": "Optional managed ChromeOS multi-printer bridge for PrintHub.",
  "permissions": ["printing", "storage"],
  "storage": {
    "managed_schema": "managed-schema.json"
  },
  "content_scripts": [
    {
      "matches": ["https://joe4816.github.io/printhub/*"],
      "js": ["content-script.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "service-worker.js"
  }
}
